<?xml version="1.0" encoding="UTF-8" ?>
<!-- Optional FastDDS Shared Memory (SHM) + UDPv4 transport profile for local IPC benchmarking on AMD desktop -->
<!-- Usage: FASTRTPS_DEFAULT_PROFILES_FILE=<path>/fastdds_shm_profile.xml RMW_IMPLEMENTATION=rmw_fastrtps_cpp bash scripts/launch_live.sh -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>shm_transport</transport_id>
            <type>SHM</type>
            <segment_size>33554432</segment_size>
            <port_queue_capacity>128</port_queue_capacity>
            <healthy_check_timeout_ms>500</healthy_check_timeout_ms>
        </transport_descriptor>
        <transport_descriptor>
            <transport_id>udpv4_transport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="wp3_shm_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>shm_transport</transport_id>
                <transport_id>udpv4_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
